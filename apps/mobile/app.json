{
  "expo": {
    "name": "Frozen Shake",
    "slug": "frozen-shake",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/logo.png",
    "scheme": "frozenshake",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frozenshake.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.frozenshake.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09242b74-2f3d-4b85-88c7-847cdd418268"
      }
    }
  }
}
